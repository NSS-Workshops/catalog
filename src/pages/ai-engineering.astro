<Layout title="AI Engineering - Workshop Catalog" currentPath="/catalog/ai-engineering">
  <div style="min-height: 100vh; background-color: var(--gray-1); padding: 1.5rem;">
    <div class="container">
      <CategoryView category={aiEngineering} client:load />
    </div>
  </div>
</Layout>