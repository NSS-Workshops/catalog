---
import Layout from '../layouts/Layout.astro';
import CategoryView from '../components/CategoryView.jsx';
import { foundationSkills } from '../data/foundation-skills.js';
---

<Layout title="Foundation Skills - Workshop Catalog" currentPath="/catalog/foundation-skills">
  <div style="min-height: 100vh; background-color: var(--gray-1); padding: 1.5rem;">
    <div class="container">
      <CategoryView category={foundationSkills} client:load />
    </div>
  </div>
</Layout>